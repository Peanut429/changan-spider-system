# Web 与 crawler 共用的数据库连接
DATABASE_URL=postgres://user:password@127.0.0.1:5432/changan_social_data

# 业务时区
SCRAPE_TIMEZONE=Asia/Shanghai

# Windows 上的 Chrome / Playwright 配置
SOCIAL_BROWSER_MODE=playwright
SOCIAL_BROWSER_USER_DATA_DIR=C:\changan-rpa\browser-profile
SOCIAL_BROWSER_PROFILE_DIRECTORY=Default
SOCIAL_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
