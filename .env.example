# 说明：根目录 .env 不会被两个 app 自动读取。
# 实际配置请分别放在 apps/web/.env 和 apps/crawler/.env。
# 这两个文件可参考 apps/*/.env.example。

DATABASE_URL=postgres://user:password@127.0.0.1:5432/changan_rpa_test
SCRAPE_TIMEZONE=Asia/Shanghai

# 仅 crawler 需要；按平台/系统填写
# SOCIAL_BROWSER_MODE=playwright
# SOCIAL_BROWSER_USER_DATA_DIR=/path/to/browser-profile
# SOCIAL_BROWSER_PROFILE_DIRECTORY=Default
# SOCIAL_BROWSER_EXECUTABLE=/path/to/Chrome
