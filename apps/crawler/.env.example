# 生产/开发数据库
DATABASE_URL=postgres://user:password@127.0.0.1:5432/changan_social_data
DB_POOL_MAX=10

# 测试库：必须与 DATABASE_URL 不同，测试 helper 会校验库名
TEST_DATABASE_URL=postgres://user:password@127.0.0.1:5432/changan_rpa_test

# 浏览器：服务器上的真实 Chrome
SOCIAL_BROWSER_MODE=playwright
SOCIAL_BROWSER_USER_DATA_DIR=C:\changan-rpa\chrome-profile-next
# 如果 profile 目录下有多个 Chrome profile，例如 Profile 3
SOCIAL_BROWSER_PROFILE_DIRECTORY=
SOCIAL_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# CDP 仅调试/登录时使用
SOCIAL_SCRAPER_CDP=http://127.0.0.1:9222

# Instagram API（TikHub）
TIKHUB_API_KEY=

# 业务时区与抓取窗口（task_date_key 的计算沿用旧项目，不改）
SCRAPE_TIMEZONE=Asia/Shanghai
SCRAPE_WINDOW_START=2026-01-01
SCRAPE_PLATFORM_ORDER=x,youtube,instagram,facebook,linkedin,tiktok
SCRAPE_ACCOUNT_TYPE=总部
