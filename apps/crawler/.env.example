# 数据库
DATABASE_URL=postgres://user:password@127.0.0.1:5432/changan_rpa_test
DB_POOL_MAX=10
SCRAPE_TIMEZONE=Asia/Shanghai

# Instagram 和 TikTok 需要；其他平台不会使用
# TikTok 数据源：默认有 TIKHUB_API_KEY 就走 TikHub App V3；填 browser 可强制回浏览器抓取
# TIKTOK_SOURCE=api
TIKHUB_API_KEY=

# YouTube 抓取方式：auto（默认，HTTP 优先，失败自动降级浏览器）/ http（只用 HTTP）/ browser（只用浏览器）
# YOUTUBE_HTTP_MODE=auto

# 需要浏览器的平台：Facebook / LinkedIn / TikTok / X / YouTube
SOCIAL_BROWSER_MODE=playwright

# macOS 示例
SOCIAL_BROWSER_USER_DATA_DIR=/Users/fuhui/outsourcing-projects/changan-rpa/work/playwright-social-profile
SOCIAL_BROWSER_PROFILE_DIRECTORY=Profile 3
SOCIAL_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Windows 示例（二选一）
# SOCIAL_BROWSER_USER_DATA_DIR=C:\changan-rpa\browser-profile
# SOCIAL_BROWSER_PROFILE_DIRECTORY=Default
# SOCIAL_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
