{
  "name": "@changan/crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "test:all": "npm run test:unit && npm run test:integration",
    "scrape:daily": "node --experimental-strip-types src/main/daily.ts",
    "platform": "node --experimental-strip-types src/main/platform.ts",
    "db:test:setup": "node --experimental-strip-types scripts/setup-test-db.ts",
    "auth:seed": "node --experimental-strip-types scripts/seed-browser-auth.ts",
    "db:test:seed": "node --experimental-strip-types scripts/seed-test-db.ts",
    "auth:x-login": "node --experimental-strip-types scripts/x-login.ts",
    "worker": "node --experimental-strip-types src/main/worker.ts",
    "comment:run": "node --experimental-strip-types src/main/comment-run.ts",
    "comment:help": "node --experimental-strip-types src/main/comment-run.ts --help"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "playwright": "1.61.0",
    "@changan/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3"
  }
}
