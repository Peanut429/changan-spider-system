{
  "name": "changan-rpa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @changan/web dev",
    "worker": "pnpm --filter @changan/crawler worker",
    "comment:run": "pnpm --filter @changan/crawler comment:run",
    "comment:help": "pnpm --filter @changan/crawler comment:help",
    "typecheck": "pnpm -r typecheck",
    "build:web": "pnpm --filter @changan/web build",
    "test": "pnpm --filter @changan/crawler test",
    "test:integration": "pnpm --filter @changan/crawler test:integration"
  }
}
